    "# Create bronze directory\n",
    "bronze_path = Path(\"../data/bronze\")\n",
    "bronze_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "run_date = '2026-03-07'\n",
    "run_date_dt = datetime(2026, 3, 7).date()\n",
    "\n",
    "# Function to save snapshot like the project\n",
    "def save_snapshot(df, base_path, table_name, run_date):\n",
    "    output_path = base_path / table_name / f\"run_date={run_date}\"\n",
    "    output_path.mkdir(parents=True, exist_ok=True)\n",
    "    file_path = output_path / \"part-00000.parquet\"  # mimic Spark naming\n",
    "    df.to_parquet(file_path, index=False)\n",
    "    return output_path\n",
    "\n",
    "# Save users\n",
    "save_snapshot(users_df, bronze_path, \"users\", run_date)\n",
    "print(f\"Wrote {len(users_df)} users to {bronze_path / 'users' / f'run_date={run_date}'}\")\n",
    "\n",
    "# Generate and save events (simplified)\n",
    "events = []\n",
    "event_id = 1\n",
    "n_outages = int(outage_rate * months_history)\n",
    "\n",
    "for _ in range(n_outages):\n",
    "    event_date = start_date + timedelta(days=int(rng.uniform(0, months_history * 30)))\n",
    "    events.append({\n",
    "        'event_id': f'E{event_id:06d}',\n",
    "        'date': event_date.date(),\n",
    "        'event_type': 'outage',\n",
    "        'intensity': rng.uniform(0.3, 1.0),\n",
    "        'affected_segment': None,\n",
    "    })\n",
    "    event_id += 1\n",
    "\n",
    "events_df = pd.DataFrame(events)\n",
    "save_snapshot(events_df, bronze_path, \"events\", run_date)\n",
    "print(f\"Wrote {len(events_df)} events to {bronze_path / 'events' / f'run_date={run_date}'}\")\n",
    "\n",
    "# Generate subscriptions\n",
    "plans = rng.choice(list(plan_mix.keys()), size=len(users_df), p=list(plan_mix.values())).tolist()\n",
    "subs_df = pd.DataFrame({\n",
    "    'subscription_id': [f'S{i+1:08d}' for i in range(len(users_df))],\n",
    "    'user_id': users_df['user_id'],\n",
    "    'plan': plans,\n",
    "    'start_date': users_df['signup_date'],\n",
    "    'end_date': None,\n",
    "    'status': 'active',\n",
    "})\n",
    "save_snapshot(subs_df, bronze_path, \"subscriptions\", run_date)\n",
    "print(f\"Wrote {len(subs_df)} subscriptions to {bronze_path / 'subscriptions' / f'run_date={run_date}'}\")\n",
    "\n",
    "# Generate payments (simplified)\n",
    "payments = []\n",
    "payment_id = 1\n",
    "\n",
    "for _, user in users_df.iterrows():\n",
    "    plan = subs_df[subs_df['user_id'] == user['user_id']]['plan'].iloc[0]\n",
    "    price = plan_prices[plan]\n",
    "    current_date = user['signup_date']\n",
    "    while current_date <= run_date_dt:\n",
    "        # Compute payment success\n",
    "        fail_rate = payment_fail_base * (1 + price_sensitivity * (price / 20.0))\n",
    "        success = rng.random() > fail_rate\n",
    "        \n",
    "        payments.append({\n",
    "            'payment_id': f'P{payment_id:010d}',\n",
    "            'user_id': user['user_id'],\n",
    "            'ts': datetime.combine(current_date, datetime.min.time()),\n",
    "            'amount': price,\n",
    "            'method': rng.choice(['credit_card', 'debit_card', 'paypal', 'bank_transfer']),\n",
    "            'success': success,\n",
    "        })\n",
    "        payment_id += 1\n",
    "        current_date = (datetime.combine(current_date, datetime.min.time()) + timedelta(days=30)).date()\n",
    "\n",
    "payments_df = pd.DataFrame(payments)\n",
    "save_snapshot(payments_df, bronze_path, \"payments\", run_date)\n",
    "print(f\"Wrote {len(payments_df)} payments to {bronze_path / 'payments' / f'run_date={run_date}'}\")\n",
    "\n",
    "# Generate usage logs (simplified)\n",
    "logs = []\n",
    "log_id = 1\n",
    "\n",
    "for _, user in users_df.iterrows():\n",
    "    plan = subs_df[subs_df['user_id'] == user['user_id']]['plan'].iloc[0]\n",
    "    current_date = user['signup_date']\n",
    "    while current_date <= run_date_dt:\n",
    "        if rng.random() > 0.7:\n",
    "            current_date = (datetime.combine(current_date, datetime.min.time()) + timedelta(days=1)).date()\n",
    "            continue\n",
    "        day_of_week = current_date.weekday()\n",
    "        \n",
    "        # Compute usage level\n",
    "        base_sessions = {'basic': 2, 'standard': 4, 'premium': 6}\n",
    "        base_minutes = {'basic': 30, 'standard': 60, 'premium': 120}\n",
    "        sessions = base_sessions[plan]\n",
    "        minutes = base_minutes[plan]\n",
    "        \n",
    "        # Weekend boost\n",
    "        if day_of_week >= 5:\n",
    "            sessions *= (1 + 0.25)\n",
    "            minutes *= (1 + 0.25)\n",
    "        \n",
    "        # Add noise\n",
    "        sessions = max(0, int(sessions * rng.normal(1, 0.2)))\n",
    "        minutes = max(0, minutes * rng.normal(1, 0.25))\n",
    "        \n",
    "        feature_a = int(rng.poisson(2) if sessions > 0 else 0)\n",
    "        feature_b = int(rng.poisson(1) if sessions > 0 else 0)\n",
    "        feature_c = int(rng.poisson(0.5) if sessions > 0 else 0)\n",
    "        log_time = datetime.combine(current_date, datetime.min.time()) + timedelta(hours=int(rng.uniform(6, 23)))\n",
    "        logs.append({\n",
    "            'log_id': f'L{log_id:012d}',\n",
    "            'user_id': user['user_id'],\n",
    "            'ts': log_time,\n",
    "            'sessions': sessions,\n",
    "            'minutes': minutes,\n",
    "            'feature_a': feature_a,\n",
    "            'feature_b': feature_b,\n",
    "            'feature_c': feature_c,\n",
    "        })\n",
    "        log_id += 1\n",
    "\n",
    "logs_df = pd.DataFrame(logs)\n",
    "save_snapshot(logs_df, bronze_path, \"usage_logs\", run_date)\n",
    "print(f\"Wrote {len(logs_df)} usage logs to {bronze_path / 'usage_logs' / f'run_date={run_date}'}\")"
   ]
