    "# Initialize simulation parameters\n",
    "rng = np.random.RandomState(42)\n",
    "n_users = 1000\n",
    "months_history = 3\n",
    "\n",
    "# Simulation parameters\n",
    "plan_mix = {'basic': 0.5, 'standard': 0.35, 'premium': 0.15}\n",
    "plan_prices = {'basic': 9.99, 'standard': 19.99, 'premium': 29.99}\n",
    "cities_list_source = ['Barcelona', 'Madrid', 'Zaragoza', 'Bilbao', 'Murcia', 'Valencia', 'Málaga', 'Sevilla']\n",
    "channels = ['organic', 'paid_search', 'social', 'referral', 'partnership']\n",
    "age_min, age_max = 18, 75\n",
    "outage_rate = 1.5\n",
    "payment_fail_base = 0.018\n",
    "price_sensitivity = 0.25\n",
    "\n",
    "# Generate users\n",
    "start_date = datetime(2023, 1, 1)\n",
    "end_date = datetime(2026, 3, 7)\n",
    "days = (end_date - start_date).days\n",
    "\n",
    "# Signup dates with exponential growth\n",
    "raw_days = rng.exponential(scale=days/3, size=n_users)\n",
    "raw_days = np.clip(raw_days, 0, days)\n",
    "signup_dates = sorted([start_date + timedelta(days=int(d)) for d in raw_days])\n",
    "\n",
    "# Demographics\n",
    "ages = (age_min + rng.beta(2, 3, size=n_users) * (age_max - age_min)).astype(int).tolist()\n",
    "cities_arr = rng.choice(cities_list_source, size=n_users).tolist()\n",
    "channels_arr = rng.choice(channels, size=n_users, p=[0.3, 0.25, 0.2, 0.15, 0.1]).tolist()\n",
    "\n",
    "users_df = pd.DataFrame({\n",
    "    'user_id': [f'U{i+1:08d}' for i in range(n_users)],\n",
    "    'signup_date': [d.date() for d in signup_dates],\n",
    "    'age': ages,\n",
    "    'city': cities_arr,\n",
    "    'acquisition_channel': channels_arr,\n",
    "})\n",
    "\n",
    "print(f\"Generated {len(users_df)} users\")\n",
    "users_df.head()"
   ]
